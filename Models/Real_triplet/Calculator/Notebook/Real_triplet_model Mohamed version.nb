      RowBox[{"Model", "->", 
       RowBox[{"{", "\"\<SM\>\"", "}"}]}], ",", 
      RowBox[{"GenericModel", "->", " ", 
       RowBox[{"{", "\"\<Lorentz\>\"", "}"}]}], ",", 
      RowBox[{"InsertionLevel", "\[Rule]", 
       RowBox[{"{", "Particles", "}"}]}], ",", " ", 
      RowBox[{"ExcludeParticles", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"S", "[", "1", "]"}], ",", " ", 
         RowBox[{"S", "[", "2", "]"}], ",", 
         RowBox[{"V", "[", 
