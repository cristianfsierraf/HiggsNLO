    RowBox[{"1", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"ExcludeTopologies", "->", 
      RowBox[{"{", 
       RowBox[{
       "TadpoleCTs", " ", ",", "WFCorrectionCTs", ",", " ", "SelfEnergyCTs"}],
        "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"VCTDiagZ", "=", 
    RowBox[{"InsertFields", "[", 
     RowBox[{"TopoVertexCT", ",", 
      RowBox[{
       RowBox[{"{", 
